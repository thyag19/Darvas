//@version=6
indicator("Darvas Box System v2.0", shorttitle="Darvas v2", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =====================================================================
// DARVAS BOX SYSTEM v2 — implements the approved working specification in
// DARVAS_SPEC.md (not a recovered historical document). The original v1
// script is kept unchanged in original/darvas_box_system_original.pine.
//
// Core (DARVAS_SPEC.md rules 1-10): K=3 top/bottom confirmation with
// independent counters, intrabar breakout (high >= box top), invalidation
// (close < confirmed box bottom), failed breakout (close < broken box's
// bottom), monotonic stop, completed boxes preserved.
//
// Everything in the "Optional extensions" group, plus volume classification,
// drawing and the statistics table, sits outside the core. At default
// settings none of it alters core behaviour.
// =====================================================================

// ---- Inputs: box construction ----
grpBox = "Box construction"
kTop = input.int(3, "Top confirmation bars", minval=1, group=grpBox,
     tooltip="Bars that must not make a strictly higher high before the top is confirmed. Core default K=3.")
kBottom = input.int(3, "Bottom confirmation bars", minval=1, group=grpBox,
     tooltip="Bars that must not make a strictly lower low before the bottom is confirmed. Core default K=3.")

// ---- Inputs: OPTIONAL EXTENSIONS (not part of the frozen core; all off by default) ----
grpExt = "Optional extensions (not frozen spec)"
lbIntra = input.int(0, "New-high lookback: intraday", minval=0, group=grpExt,
     tooltip="Optional extension, NOT part of the core spec. A box search only starts on a bar whose high exceeds the highest high of the previous N bars. 0 = off (core: any bar can start a search).")
lbDaily = input.int(0, "New-high lookback: daily", minval=0, group=grpExt)
lbWeekly = input.int(0, "New-high lookback: weekly and above", minval=0, group=grpExt)
trendLen = input.int(0, "Trend filter: close above SMA (0 = off)", minval=0, group=grpExt,
     tooltip="Optional extension, NOT part of the core spec. Only start a box search while the close is above this SMA. 0 = off.")

breakoutBasis = input.string("High (intrabar)", "Breakout trigger", options=["High (intrabar)", "Close"], group=grpExt,
     tooltip="Core rule: intrabar high >= box top (default). 'Close' is an optional extension that changes the core breakout rule.")
breakoutBuffer = input.float(0.0, "Breakout buffer above top (%)", minval=0.0, step=0.05, group=grpExt,
     tooltip="Core rule: trigger at the box top (0). Any value above 0 is an optional extension that changes the core breakout rule.")
stopBasis = input.string("Close", "Invalidation / failed-breakout trigger", options=["Close", "Low (intrabar)"], group=grpExt,
     tooltip="Core rule: close below the box bottom (default). 'Low (intrabar)' is an optional extension that changes both the invalidation and failed-breakout rules.")

// ---- Inputs: breakout volume classification (labels only, never blocks a breakout) ----
grpBo = "Breakout volume (classification only)"
volLen = input.int(50, "Volume average length", minval=1, group=grpBo)
volMult = input.float(1.5, "Strong-breakout volume multiple (0 = off)", minval=0.0, step=0.1, group=grpBo,
     tooltip="A breakout whose volume is at least this multiple of the prior average is marked STRONG. This only classifies; it never blocks a breakout (core rule 5: no volume requirement).")

// ---- Inputs: display ----
grpDisp = "Display"
showBoxes           = input.bool(true, "Draw boxes", group=grpDisp)
showHistoricalBoxes = input.bool(true, "Keep completed boxes visible", group=grpDisp)
showFormingBox      = input.bool(true, "Draw provisional (forming) box", group=grpDisp)
showCandidateLines  = input.bool(true, "Show forming candidate top/bottom", group=grpDisp)
showStopLine        = input.bool(true, "Show monotonic stop level", group=grpDisp)
showTrigger         = input.bool(true, "Show breakout (buy-stop) price", group=grpDisp)
showTable           = input.bool(true, "Show statistics table (indicative only)", group=grpDisp)
tablePosIn          = input.string("Top right", "Table position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=grpDisp)

colConfirmedBox  = input.color(color.new(color.blue, 0), "Confirmed box", group=grpDisp)
colFormingBox    = input.color(color.new(color.orange, 30), "Forming box", group=grpDisp)
colHistoricalBox = input.color(color.new(color.gray, 60), "Completed box (breakout)", group=grpDisp)
colFailedBox     = input.color(color.new(color.red, 40), "Completed box (failed / invalidated)", group=grpDisp)
colCandidate     = input.color(color.new(color.orange, 0), "Forming candidate lines", group=grpDisp)
colStop          = input.color(color.new(color.red, 0), "Stop level", group=grpDisp)
colTrigger       = input.color(color.new(color.green, 0), "Breakout price", group=grpDisp)

// ---- Derived settings ----
bool breakOnClose = breakoutBasis == "Close"
bool stopOnLow    = stopBasis == "Low (intrabar)"
int  lookback     = timeframe.isintraday ? lbIntra : timeframe.isdaily ? lbDaily : lbWeekly
tblPos = tablePosIn == "Top right" ? position.top_right :
     tablePosIn == "Top left" ? position.top_left :
     tablePosIn == "Bottom right" ? position.bottom_right : position.bottom_left

// ---- Completed-box record (rule 10: completed boxes are preserved) ----
// One record per box that stops being the active box (via breakout or
// invalidation), independent of the box.* drawing object used for display.
type HistoricalBox
    float  top
    float  bottom
    int    startBar
    int    endBar
    bool   brokeOut

// BREAKOUT / BOX_INVALIDATED / FAILED_BREAKOUT are same-bar event flags
// (fire-and-transition within one bar), not persistent states.
enum BoxState
    no_box
    box_forming
    box_confirmed

var BoxState state = BoxState.no_box

// ---- Candidate top ----
var float candTop     = na
var int   topBar       = na
var int   topCounter   = 0
var bool  topConfirmed = false

// ---- Candidate bottom ----
var float candBottom     = na
var int   bottomBar       = na
var int   bottomCounter   = 0
var bool  bottomConfirmed = false

// ---- Confirmed box boundaries ----
var float boxTop     = na
var float boxBottom  = na
var int   boxLeftBar = na

// ---- Stop mechanism ----
var float stopLevel       = na   // rule 8: only ever raised (max of confirmed bottoms), never reset or lowered
var float brokenBottom    = na   // bottom of the box most recently broken out of (failed-breakout reference)
var bool  breakoutPending = false

// ---- Drawing handles ----
var box activeBoxId = na
var box formBoxId   = na

// ---- History and simple trade statistics ----
var array<HistoricalBox> historicalBoxes = array.new<HistoricalBox>()
var float entryPx   = na
var int   nTrades   = 0
var int   nWins     = 0
var float sumWin    = 0.0
var float sumLoss   = 0.0

// ---- Per-bar event flags and values ----
bool  evBreakout       = false
bool  evBoxInvalidated = false
bool  evFailedBreakout = false
bool  evBoxConfirmed   = false
bool  evStrong         = false
float entryFill        = na
float exitFill         = na

h = high
l = low
c = close

// ---- Per-bar calculations (global scope so history is always built) ----
float priorHigh = ta.highest(high, math.max(lookback, 1))[1]
float trendMa   = ta.sma(close, math.max(trendLen, 1))
float volAvg    = ta.sma(volume, volLen)[1]
bool  newHighOk = lookback <= 0 or h > priorHigh
bool  trendOk   = trendLen <= 0 or c > trendMa
bool  volStrong = volMult <= 0 or (not na(volAvg) and volume >= volAvg * volMult)

// =====================================================================
// STATE: NO_BOX
// =====================================================================
if state == BoxState.no_box
    // Core: any bar starts a search, with no cooldown after an invalidation or
    // failed breakout. Optional extensions (lookback, trend filter) gate this
    // and are off by default.
    if newHighOk and trendOk
        candTop      := h
        topBar        := bar_index
        topCounter    := 0
        topConfirmed  := false
        candBottom      := na
        bottomBar        := na
        bottomCounter    := 0
        bottomConfirmed  := false
        boxTop    := na
        boxBottom := na
        state := BoxState.box_forming

// =====================================================================
// STATE: BOX_FORMING
// =====================================================================
else if state == BoxState.box_forming

    // --- Top tracking ---
    if h > candTop
        candTop      := h
        topBar        := bar_index
        topCounter    := 0
        topConfirmed  := false
        // A top reset fully restarts the bottom search.
        candBottom      := na
        bottomBar        := na
        bottomCounter    := 0
        bottomConfirmed  := false
    else
        topCounter += 1
        if topCounter >= kTop
            topConfirmed := true

    // --- Bottom tracking (starts the bar after the candidate top) ---
    // A bottom reset does not cascade back to the top.
    if bar_index > topBar
        if na(candBottom)
            candBottom      := l
            bottomBar        := bar_index
            bottomCounter    := 0
            bottomConfirmed  := false
        else if l < candBottom
            candBottom      := l
            bottomBar        := bar_index
            bottomCounter    := 0
            bottomConfirmed  := false
        else
            bottomCounter += 1
            if bottomCounter >= kBottom and not bottomConfirmed
                bottomConfirmed := true
                // Post-breakout the stop trails on bottom confirmation alone.
                if breakoutPending
                    stopLevel := na(stopLevel) ? candBottom : math.max(stopLevel, candBottom)

    // --- Failed-breakout watch (post-breakout only) ---
    // Rule 7: close below the broken box's bottom (not the ratcheting stop).
    // Evaluated from the bar after the breakout bar.
    bool failedNow = breakoutPending and not na(brokenBottom) and (stopOnLow ? l < brokenBottom : c < brokenBottom)
    if failedNow
        evFailedBreakout := true
        exitFill := stopOnLow ? math.min(open, brokenBottom) : c
        if not na(activeBoxId)
            if showHistoricalBoxes
                box.set_border_color(activeBoxId, colFailedBox)
                box.set_bgcolor(activeBoxId, color.new(colFailedBox, 90))
            else
                box.delete(activeBoxId)
            activeBoxId := na
        state := BoxState.no_box
        brokenBottom      := na
        breakoutPending   := false
        candTop    := na
        candBottom := na
        boxTop     := na
        boxBottom  := na

    // --- Box confirmation: fires at the LATER of the two confirmations ---
    else if topConfirmed and bottomConfirmed
        evBoxConfirmed := true
        boxTop     := candTop
        boxBottom  := candBottom
        boxLeftBar := topBar
        state := BoxState.box_confirmed

        stopLevel := na(stopLevel) ? boxBottom : math.max(stopLevel, boxBottom)
        breakoutPending := false   // failed-breakout window closes here
        brokenBottom    := na

        activeBoxId := showBoxes ? box.new(left=boxLeftBar, top=boxTop, right=bar_index, bottom=boxBottom,
             border_color=colConfirmedBox, bgcolor=color.new(colConfirmedBox, 90), extend=extend.none) : na

// =====================================================================
// STATE: BOX_CONFIRMED
// =====================================================================
else if state == BoxState.box_confirmed

    if not na(activeBoxId)
        box.set_right(activeBoxId, bar_index)

    float trigger = boxTop * (1 + breakoutBuffer / 100)

    // --- Breakout test ---
    // Rule 5: intrabar high >= box top (default buffer 0, so trigger = box top).
    // Precedence: if one bar both reaches the top and closes below the box
    // bottom, the breakout wins (rule 9 terminates the box on that bar) and the
    // failed-breakout test (rule 7) first applies on the next bar.
    if (breakOnClose ? c > trigger : h >= trigger)
        evBreakout := true
        evStrong   := volStrong
        // Statistics only: gap-aware buy-stop fill: a gap above the trigger fills at the open.
        entryFill := breakOnClose ? c : math.max(open, trigger)

        // The handle is kept so a later failed breakout can recolour this box.
        if not na(activeBoxId)
            if showHistoricalBoxes
                box.set_border_color(activeBoxId, colHistoricalBox)
                box.set_bgcolor(activeBoxId, color.new(colHistoricalBox, 95))
            else
                box.delete(activeBoxId)
                activeBoxId := na

        array.push(historicalBoxes, HistoricalBox.new(boxTop, boxBottom, boxLeftBar, bar_index, true))

        candTop      := h
        topBar        := bar_index
        topCounter    := 0
        topConfirmed  := false
        candBottom      := na
        bottomBar        := na
        bottomCounter    := 0
        bottomConfirmed  := false

        brokenBottom := boxBottom
        // Rule 9: candTop above is the breakout bar's high, with no gap.
        // stopLevel already equals max(previous stop, boxBottom); it only
        // rises when a later bottom confirms.
        breakoutPending := true
        state := BoxState.box_forming

    // --- Invalidation (rule 6: close < confirmed box bottom) ---
    else if (stopOnLow ? l < boxBottom : c < boxBottom)
        evBoxInvalidated := true
        exitFill := stopOnLow ? math.min(open, boxBottom) : c

        if not na(activeBoxId)
            if showHistoricalBoxes
                box.set_border_color(activeBoxId, colFailedBox)
                box.set_bgcolor(activeBoxId, color.new(colFailedBox, 90))
            else
                box.delete(activeBoxId)
            activeBoxId := na

        array.push(historicalBoxes, HistoricalBox.new(boxTop, boxBottom, boxLeftBar, bar_index, false))

        state := BoxState.no_box
        candTop    := na
        candBottom := na
        boxTop     := na
        boxBottom  := na

// =====================================================================
// SIMPLE TRADE LOG (long only, first breakout enters, stop event exits;
// stacked boxes do not add size). INDICATIVE ONLY, not a validated backtest:
// no commissions, slippage, position sizing or intrabar-order modelling.
// =====================================================================
if evBreakout and na(entryPx)
    entryPx := entryFill

if not na(exitFill) and not na(entryPx)
    float ret = (exitFill / entryPx - 1) * 100
    nTrades += 1
    if ret > 0
        nWins += 1
        sumWin += ret
    else
        sumLoss += ret
    entryPx := na

// =====================================================================
// PROVISIONAL BOX (dashed) while a box is forming
// =====================================================================
if showBoxes and showFormingBox and state == BoxState.box_forming and not na(candTop) and not na(candBottom)
    if na(formBoxId)
        formBoxId := box.new(left=topBar, top=candTop, right=bar_index, bottom=candBottom,
             border_color=colFormingBox, border_style=line.style_dashed, bgcolor=na)
    else
        box.set_lefttop(formBoxId, topBar, candTop)
        box.set_rightbottom(formBoxId, bar_index, candBottom)
else if not na(formBoxId)
    box.delete(formBoxId)
    formBoxId := na

// =====================================================================
// PLOTS
// =====================================================================
plot(showCandidateLines and state == BoxState.box_forming and not na(candTop) ? candTop : na,
     "Candidate Top", color=colCandidate, style=plot.style_circles, linewidth=1)
plot(showCandidateLines and state == BoxState.box_forming and not na(candBottom) ? candBottom : na,
     "Candidate Bottom", color=colCandidate, style=plot.style_circles, linewidth=1)

plot(showStopLine and not na(stopLevel) ? stopLevel : na,
     "Stop Level", color=colStop, style=plot.style_stepline, linewidth=2)

// Breakout price while a confirmed box is active.
plot(showTrigger and state == BoxState.box_confirmed ? boxTop * (1 + breakoutBuffer / 100) : na,
     "Breakout Price", color=colTrigger, style=plot.style_linebr, linewidth=1)

plotshape(evBoxConfirmed, title="Box Confirmed", style=shape.diamond, location=location.abovebar,
     color=color.new(color.blue, 0), size=size.tiny)
plotshape(evBreakout and evStrong, title="Strong Breakout", style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.normal)
plotshape(evBreakout and not evStrong, title="Weak Breakout", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 55), size=size.small)
plotshape(evFailedBreakout, title="Failed Breakout", style=shape.xcross, location=location.abovebar,
     color=color.orange, size=size.small)
plotshape(evBoxInvalidated, title="Box Invalidated", style=shape.xcross, location=location.abovebar,
     color=color.red, size=size.small)

// ---- State label on the last bar ----
var label stateLabel = na
if barstate.islast
    if not na(stateLabel)
        label.delete(stateLabel)
    string stateTxt = state == BoxState.no_box ? "NO_BOX" :
         state == BoxState.box_forming ? (breakoutPending ? "BOX_FORMING (post-breakout)" : "BOX_FORMING") :
         "BOX_CONFIRMED"
    if state == BoxState.box_confirmed
        stateTxt += "\nBuy above " + str.tostring(boxTop * (1 + breakoutBuffer / 100), format.mintick)
    if not na(stopLevel)
        stateTxt += "\nStop " + str.tostring(stopLevel, format.mintick)
    stateLabel := label.new(bar_index, high, stateTxt, style=label.style_label_down, color=color.black, textcolor=color.white)

// ---- Statistics table ----
var table statsTbl = table.new(tblPos, 2, 9, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast and showTable
    int   nDone = array.size(historicalBoxes)
    int   nBo   = 0
    float sumHt = 0.0
    float sumWd = 0.0
    for hb in historicalBoxes
        nBo += hb.brokeOut ? 1 : 0
        sumHt += (hb.top / hb.bottom - 1) * 100
        sumWd += hb.endBar - hb.startBar
    int   nLoss = nTrades - nWins
    float pf    = sumLoss < 0 ? sumWin / -sumLoss : na

    table.cell(statsTbl, 0, 0, "Completed boxes", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 0, str.tostring(nDone), text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 1, "Broke out", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 1, nDone > 0 ? str.tostring(nBo / nDone * 100, "#") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 2, "Avg box height", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 2, nDone > 0 ? str.tostring(sumHt / nDone, "#.##") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 3, "Avg box width", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 3, nDone > 0 ? str.tostring(sumWd / nDone, "#.#") + " bars" : "-", text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 4, "Trades (closed)", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 4, str.tostring(nTrades), text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 5, "Win rate", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 5, nTrades > 0 ? str.tostring(nWins / nTrades * 100, "#") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 6, "Avg win / avg loss", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 6, nWins > 0 and nLoss > 0 ? str.tostring(sumWin / nWins, "#.#") + "% / " + str.tostring(sumLoss / nLoss, "#.#") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 7, "Profit factor", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(statsTbl, 1, 7, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(statsTbl, 0, 8, "INDICATIVE ONLY - not a validated backtest", text_color=color.yellow, text_size=size.tiny)
    table.merge_cells(statsTbl, 0, 8, 1, 8)

// ---- Alerts ----
alertcondition(evBoxConfirmed, "Darvas Box Confirmed", "Darvas box confirmed (top and bottom set)")
alertcondition(evBreakout, "Darvas Breakout", "Darvas box breakout (high at or above box top)")
alertcondition(evBreakout and evStrong, "Darvas Strong Breakout", "Darvas box breakout on high volume")
alertcondition(evFailedBreakout, "Darvas Failed Breakout", "Close below the broken box bottom after a breakout")
alertcondition(evBoxInvalidated, "Darvas Box Invalidated", "Close below confirmed box bottom")
